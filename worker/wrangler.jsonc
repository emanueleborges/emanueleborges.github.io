{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emanuel-portfolio-chat",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Logs (Workers Logs, grátis): só as mensagens que o próprio Worker escreve (erros técnicos, nunca o texto
  // do visitante); sem os dados de cada pedido (invocation_logs) e sem a query string das URLs.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false }
  },
  // Métricas técnicas (Workers Analytics Engine, grátis): rota, resultado e tempo de resposta de cada
  // pedido — sem texto, IP, idioma ou identificador do visitante. Lidas pelo `npm run painel`.
  "analytics_engine_datasets": [{ "binding": "METRICAS", "dataset": "portfolio_metricas" }],
  // Navegador da Cloudflare (Browser Run, grátis: 10 min/dia) para gerar o currículo em PDF (GET /cv).
  "browser": { "binding": "BROWSER" },
  // IA do Cloudflare (Workers AI) — cota gratuita de 10.000 neurônios por dia.
  "ai": { "binding": "AI" },
  // Índice vetorial gratuito (Vectorize) com os trechos do perfil, para o RAG do chat.
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "portfolio-profile" }],
  // Banco gratuito (D1) com totais diários de avaliação e acesso regional.
  // Também guarda os totais diários de cliques nos links.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-contact",
      "database_id": "df869507-7b2b-42f0-a442-946fa0a176b9",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Só o portfólio publicado pode chamar este Worker.
    "ALLOWED_ORIGIN": "https://emanueleborges.github.io",
    // Recebe o resumo semanal agregado (precisa ser o e-mail da conta do Resend).
    "NOTIFY_EMAIL": "emanuel.eborges@gmail.com"
  },
  // Até 10 perguntas por minuto por visitante (IP).
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    // Até 20 avaliações (👍/👎) por minuto por visitante (IP).
    {
      "name": "FEEDBACK_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 20, "period": 60 }
    },
    // Até 3 análises de vaga ("Essa vaga combina?") por minuto por visitante (IP).
    {
      "name": "MATCH_LIMITER",
      "namespace_id": "1005",
      "simple": { "limit": 3, "period": 60 }
    },
    // Até 30 consultas de preços (demo do LSTM) por minuto por visitante (IP).
    {
      "name": "PRICES_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 30, "period": 60 }
    },
    // Evita que um mesmo IP gere volume excessivo de contagens regionais.
    {
      "name": "VISIT_LIMITER",
      "namespace_id": "1006",
      "simple": { "limit": 20, "period": 60 }
    },
    // Até 30 cliques registrados por minuto por visitante (IP).
    {
      "name": "CLICK_LIMITER",
      "namespace_id": "1007",
      "simple": { "limit": 30, "period": 60 }
    },
    // Até 2 imagens por minuto por visitante (demo do gerador de imagens); há também um teto diário no D1.
    {
      "name": "IMAGE_LIMITER",
      "namespace_id": "1008",
      "simple": { "limit": 2, "period": 60 }
    },
    {
      "name": "CV_LIMITER",
      "namespace_id": "1009",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "TRANSCRIBE_LIMITER",
      "namespace_id": "1010",
      "simple": { "limit": 6, "period": 60 }
    }
  ],
  // Retenção verificada a cada hora; resumo agregado semanal na segunda às 12:00 UTC.
  "triggers": { "crons": ["0 * * * *", "0 12 * * 1"] },
  "observability": { "enabled": true }
}
