{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "emanuel-portfolio-chat",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // IA do Cloudflare (Workers AI) — cota gratuita de 10.000 neurônios por dia.
  "ai": { "binding": "AI" },
  // Banco gratuito (D1) com as mensagens do formulário de contato.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-contact",
      "database_id": "df869507-7b2b-42f0-a442-946fa0a176b9",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Só o portfólio publicado pode chamar este Worker.
    "ALLOWED_ORIGIN": "https://emanueleborges.github.io"
  },
  // Até 10 perguntas por minuto por visitante (IP).
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    // Até 3 mensagens de contato por minuto por visitante (IP).
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
